# Keep real credentials in your environment, never in Git.
DATABASE_URL="postgresql://saas_app:password@localhost:5432/daira_saas"
APP_SECRET="replace-with-a-64-character-hexadecimal-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional adapters; the app disables these features until configured.
MAIL_HTTP_ENDPOINT=""
MAIL_HTTP_TOKEN=""
SMS_HTTP_ENDPOINT=""
SMS_HTTP_TOKEN=""
PAYMENT_PROVIDER="disabled"
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"
# Protects the daily Vercel scheduled maintenance endpoint.
CRON_SECRET=""
# Docker Compose only: choose a long random password and URL-encode reserved characters.
POSTGRES_PASSWORD=""
PORT="3000"
